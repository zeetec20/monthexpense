{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "receipt-parser",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": [],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "ai": {
    "binding": "AI",
  },
  "ratelimits": [
    {
      // Guards the shared API_KEY against abuse — see middleware/rate-limit.ts.
      // Keyed on IP+User-Agent, not IP alone (see that file for why).
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 },
    },
  ],
  // API_KEY, REGULAR_API_KEY, PREMIUM_API_KEY, UPSTASH_REDIS_REST_URL,
  // UPSTASH_REDIS_REST_TOKEN are secrets — set via `wrangler secret put
  // <NAME>` (or dashboard -> Worker -> Settings -> Variables -> encrypted),
  // never here.
  "vars": {
    "MODEL_NAME": "@cf/meta/llama-3.1-8b-instruct-fast",
    "MAX_INPUT_LENGTH": 15000,
    "MAX_AUDIO_BYTES": 3000000,
    "AI_TIMEOUT_MS": 15000,
    "MAX_REPAIR_ATTEMPTS": 1,
    "API_VERSION": "v1",
    "SERVICE_VERSION": "1.0.0",
    "LOCAL_MOCK_AI": false,
  },
}
