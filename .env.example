# ==============================================================================
# MonthExpense - Unified Environment Configuration
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# Vite (frontend) and Cloudflare Worker (backend) automatically synchronize
# configuration from .env. You DO NOT need a separate .dev.vars file.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core API Secret (Required)
# ------------------------------------------------------------------------------
# Shared secret for authenticating API requests and encrypting transit tokens.
# Both Cloudflare Worker (API_KEY) and the frontend client (VITE_RECEIPT_API_KEY)
# use this secret. You only need to define it once here.
API_KEY=local-dev-secret-change-me

# ------------------------------------------------------------------------------
# 2. Google OAuth & Cloud Backup (Required for Google Sheets sync)
# ------------------------------------------------------------------------------
# Web Client ID from Google Cloud Console (APIs & Services > Credentials).
# Ensure Authorized JavaScript Origins include your local dev and production URLs:
#   - http://localhost:5173
#   - https://<your-worker-subdomain>.workers.dev
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 3. Sheet Identity HMAC Secrets (Optional in local dev)
# ------------------------------------------------------------------------------
# Used to mint and verify HMAC tokens for Google Sheets identity sync tiers.
REGULAR_API_KEY=local-dev-regular-secret-change-me
PREMIUM_API_KEY=local-dev-premium-secret-change-me

# ------------------------------------------------------------------------------
# 4. Upstash Redis Quota & Rate Limiting (Optional in local dev)
# ------------------------------------------------------------------------------
# REST credentials from https://console.upstash.com
# Backs per-sheet quota tracking and concurrency locks.
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# ------------------------------------------------------------------------------
# 5. Local Development Flags (Optional)
# ------------------------------------------------------------------------------
# Set to true to skip real Cloudflare Workers AI calls locally and use mock responses:
# LOCAL_MOCK_AI=false

# Leave blank to use same-origin relative URLs (/v1/*) when running as a unified fullstack app.
# Only set if hosting the worker on a separate domain from the frontend:
# VITE_RECEIPT_API_URL=
