{
  "name": "monthexpense",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && rm -f dist/client/assets/*.wasm dist/assets/*.wasm dist/client/_redirects && bun scripts/clean-wrangler-dist.ts",
    "preview": "vite preview",
    "deploy": "bun run build && wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "test": "bun run test:worker && bun run test:client",
    "test:worker": "vitest run",
    "test:worker:watch": "vitest",
    "test:client": "bun test src/",
    "typecheck": "tsc -b",
    "types": "wrangler types",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "tunnel": "bun scripts/tunnel.ts",
    "dev:tunnel": "bun scripts/tunnel.ts",
    "generate-icons": "bun scripts/generate-icons.mjs",
    "mint-secret": "bun scripts/mint-secret.ts"
  },
  "dependencies": {
    "@paddleocr/paddleocr-js": "^0.1.0",
    "@upstash/redis": "^1.38.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "heic2any": "^0.0.4",
    "hono": "^4.13.5",
    "lucide-react": "^0.469.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-zoom-pan-pinch": "^4.0.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^2.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.60.2",
    "@cloudflare/vitest-pool-workers": "^0.8.0",
    "@cloudflare/workers-types": "^5.20260821.1",
    "@tailwindcss/vite": "^4.0.0",
    "@types/bun": "^1.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.5",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "shadcn": "^4.19.0",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.0",
    "wrangler": "4.86.0"
  }
}
